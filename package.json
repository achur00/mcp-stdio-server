{
  "name": "typespec-mcp-server",
  "version": "1.0.0",
  "description": "A TypeSpec Model Context Protocol (MCP) server implementation",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "typespec:compile": "tsp compile .",
    "typespec:watch": "tsp compile . --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@typespec/compiler": "^0.61.0",
    "@typespec/openapi3": "^0.61.0",
    "@typespec/http": "^0.61.0",
    "@typespec/rest": "^0.61.0",
    "@typespec/json-schema": "^0.61.0",
    "express": "^4.18.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "tsx": "^4.6.2",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "typespec",
    "openapi",
    "api-specification"
  ],
  "author": "",
  "license": "MIT"
}